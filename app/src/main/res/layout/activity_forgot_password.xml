<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/primary_blue"
        android:padding="16dp"
        android:paddingTop="44dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnForgotBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/circle_white"
            android:padding="10dp"
            app:tint="@color/primary_blue"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Reset Password"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <View android:layout_width="40dp" android:layout_height="40dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter your username and registered email. Verify with fingerprint, then set a new password."
                android:textSize="14sp"
                android:textColor="@color/primary_blue"
                android:background="@drawable/bg_status_green"
                android:padding="14dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etForgotUsername"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Enter your username"
                android:textSize="15sp"
                android:background="@drawable/bg_chat_bot"
                android:paddingHorizontal="16dp"
                android:inputType="text"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registered Email"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etForgotEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="you@example.com"
                android:textSize="15sp"
                android:background="@drawable/bg_chat_bot"
                android:paddingHorizontal="16dp"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnVerifyBiometric"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="🔐 Verify Fingerprint to Continue"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:backgroundTint="@color/primary_green"
                android:layout_marginBottom="24dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutPasswordSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New Password"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="At least 8 characters"
                    android:textSize="15sp"
                    android:background="@drawable/bg_chat_bot"
                    android:paddingHorizontal="16dp"
                    android:inputType="textPassword"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Confirm New Password"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etConfirmNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Repeat new password"
                    android:textSize="15sp"
                    android:background="@drawable/bg_chat_bot"
                    android:paddingHorizontal="16dp"
                    android:inputType="textPassword"
                    android:layout_marginBottom="28dp" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Reset Password"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/primary_blue"
                app:cornerRadius="26dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>