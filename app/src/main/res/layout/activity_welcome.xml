<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <!-- Animated Background Elements -->
    <View
        android:id="@+id/bgCircle1"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/circle_glow_purple"
        android:alpha="0.2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-50dp"
        android:layout_marginEnd="-50dp" />

    <View
        android:id="@+id/bgCircle2"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:background="@drawable/circle_glow_green"
        android:alpha="0.15"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="-30dp"
        android:layout_marginStart="-30dp" />

    <!-- Main Content - Centered, no ScrollView -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <!-- Logo -->
        <LinearLayout
            android:id="@+id/logoContainer"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/circle_white"
            android:gravity="center"
            android:elevation="8dp">

            <ImageView
                android:id="@+id/logoImage"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/icon" />
        </LinearLayout>

        <!-- App Name -->
        <TextView
            android:id="@+id/appName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GLUCARE"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.1" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/diabetes_management_app"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:alpha="0.9"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="48dp" />

        <!-- Get Started Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGetStarted"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:text="@string/get_started"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="@color/white"
            android:textColor="@color/primary_blue"
            app:cornerRadius="24dp"
            android:elevation="4dp"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd"
            app:iconPadding="8dp" />

    </LinearLayout>

    <!-- Version at Bottom -->
    <TextView
        android:id="@+id/versionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Version 1.0.0"
        android:textSize="10sp"
        android:textColor="@color/white"
        android:alpha="0.5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginBottom="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>